            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum by (m) (sum_over_time({event_name=\"api_request\"} | label_format m=\"{{ .model | trimPrefix \\\"claude-\\\" }}\" | unwrap effective_tokens [$__range]))",
          "legendFormat": "{{m}}"
        }
      ]
    },
    {
      "id": 29,
      "type": "piechart",
      "title": "",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 10,
        "y": 3,
        "w": 5,
        "h": 3
      },
      "timeFrom": "now/d",
      "hideTimeOverride": true,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "pie",
        "displayLabels": [],
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "values": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "input"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "cache_read"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "creation"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "output"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(sum_over_time({event_name=\"api_request\"} | unwrap input_tokens [$__range])) * 1.0",
          "legendFormat": "input"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(sum_over_time({event_name=\"api_request\"} | unwrap cache_read_tokens [$__range])) * 0.1",
          "legendFormat": "cache_read"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(sum_over_time({event_name=\"api_request\"} | unwrap cache_creation_tokens [$__range])) * 1.25",
          "legendFormat": "creation"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(sum_over_time({event_name=\"api_request\"} | unwrap output_tokens [$__range])) * 5.0",
          "legendFormat": "output"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "累計コスト",
      "description": "本日 07:00 からの累積コスト（5分ビン累積・step 5m 固定）と過去同曜日3週の同時刻平均、$150 赤破線。3週平均はデータの無い週を $0 として常に /3 で割る（運用開始から3週間は過小に出る）。開始を 07:00 に固定して早朝の空白帯を刈っている — 07:00 以前に実績がある日はその分が累積に含まれず本日コスト stat と乖離する（稀・許容）。終端は現在時刻（Grafana はパネル単位の終端固定・データ駆動レンジをサポートしないため、17:00 固定は他パネルの相対窓と両立しない）。日末着地はこのカーブの目視外挿で判断する。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({event_name=\"api_request\"} | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [5m]))",
          "legendFormat": "raw_today",
          "queryType": "range",
          "step": "5m"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "((sum(sum_over_time({event_name=\"api_request\"} | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [5m] offset 7d)) or vector(0)) + (sum(sum_over_time({event_name=\"api_request\"} | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [5m] offset 14d)) or vector(0)) + (sum(sum_over_time({event_name=\"api_request\"} | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [5m] offset 21d)) or vector(0))) / 3",
          "legendFormat": "raw_avg",
          "queryType": "range",
          "step": "5m"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "cumulativeFunctions",
            "cumulative": {
              "field": "raw_today",
              "statistic": "sum"
            },
            "alias": "本日（累積）",
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "cumulativeFunctions",
            "cumulative": {
              "field": "raw_avg",
              "statistic": "sum"
            },
            "alias": "同曜日平均（3週・累積）",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "raw_today": true,
              "raw_avg": true
            },
            "renameByName": {}
          }
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "同曜日平均（3週・累積）"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    4,
                    4
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "コンテキスト遷移",
      "description": "セッションごとの context_tokens の時系列（系列名 = workspace｜session先頭8桁）。読み方: 段差で下がった直後 = compact/clear 済み（今はしない）/ 急増 = 取り込み過多（対象限定・委任を検討）/ 漸増しながら150K破線に接近 × まだ続ける = 早めに手動 /compact。15分以上イベントが無い区間は線を繋がないため、右端までの空白 = 最終活動からの経過時間（1h超なら TTL 失効 — 再開時に再構築費を払う）。凡例は現在値の降順。 線上の点をクリック → 「このセッションの診断」でセッション詳細（Context を session_id で絞り込み）へ遷移できる。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "timeFrom": "3h",
      "hideTimeOverride": true,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max by (ws, sid, session_id, workspace) (max_over_time({event_name=\"api_request\"} | label_format sid=\"{{ substr 0 8 .session_id }}\", ws=\"{{ if gt (len .workspace) 8 }}{{ substr 0 8 .workspace }}...{{ else }}{{ .workspace }}{{ end }}\" | unwrap context_tokens [$__interval]))",
          "legendFormat": "{{ws}}",
          "queryType": "range"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 4,
            "spanNulls": 900000,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 150000
              },
              {
                "color": "red",
                "value": 180000
              }
            ]
          },
          "links": [
            {
              "title": "このセッションに絞った Today を開く",
              "url": "/d/claude-code-workspace/claude-code-workspace?var-session_id=${__field.labels.session_id}&var-workspace=${__field.labels.workspace}&from=now/d&to=now"
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "barchart",
      "title": "バーン遷移（3h）",
