{
  "uid": "claude-code-prompt",
  "title": "Claude Code Prompt明細",
  "tags": [
    "claude-code"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prompt_id",
        "label": "prompt_id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "description": "コストドライバ/prompt別テーブルの行リンク、または prompt_id を貼り付け"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 13,
      "title": "入口",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "table",
      "id": 12,
      "title": "直近のプロンプト一覧（入口）",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "prompt_id 未指定でもこのページを使えるようにする入口。表示期間内の user_prompt を新しい順に一覧し、prompt_id リンクで明細（このページの変数に反映）へ遷移する。通常の入口は Cost Opt / Context の prompt テーブル行リンク。 コスト列はプロンプト単位の合計（列ヘッダクリックで高額順に並べ替え）。",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{event_name=\"user_prompt\"}",
          "maxLines": 50,
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (prompt_id) (sum_over_time({event_name=\"api_request\"} | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [$__range]))",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(Time|prompt_id|prompt|Value #B)$"
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "prompt_id",
            "mode": "outer"
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "prompt",
                "config": {
                  "id": "isNotNull",
                  "options": {}
                }
              }
            ],
            "match": "all",
            "type": "include"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 2": true
            },
            "renameByName": {
              "Time 1": "Time",
              "Value #B": "コスト(USD)"
            },
            "indexByName": {
              "Time": 0,
              "prompt_id": 1,
              "コスト(USD)": 2,
              "prompt": 3
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "prompt_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 320
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "この prompt の明細を表示",
                    "url": "/d/claude-code-prompt/claude-code-prompt?var-prompt_id=${__data.fields.prompt_id}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "コスト(USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    },
    {
