        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "施策マーカー",
        "expr": "{event_name=\"intervention_marker\"}",
        "textFormat": "{{category}}: {{description}}",
        "titleFormat": "intervention"
      }
