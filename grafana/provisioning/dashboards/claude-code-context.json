{
  "uid": "claude-code-context",
  "title": "Claude Code Context（診断ドリルダウン）",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "tags": [
    "claude-code",
    "context"
  ],
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "30s",
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "施策 (intervention_marker)",
        "target": {
          "expr": "{event_name=\"intervention_marker\", workspace=~\"$workspace\"}",
          "refId": "Anno"
        },
        "textFormat": "{{category}}: {{description}}",
        "titleFormat": "intervention"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "workspace",
        "label": "workspace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values(workspace)",
        "query": {
          "label": "workspace",
          "stream": "",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "session_id",
        "label": "session_id",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "セッション詳細ドリルダウン用（Today のcontext推移の点クリックから遷移。.* で全セッション）"
      }
    ]
  },
  "panels": [
    {
      "id": 30,
      "type": "row",
      "title": "workspace サマリ — どのセッションが問題か",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "累計コスト (USD)",
      "description": "表示期間内のコスト合計 (cost_recalc = pricing.yaml×実トークンの再計算値。ADR 0006)。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({event_name=\"api_request\", workspace=~\"$workspace\"} | session_id=~\"${session_id}\" | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "logs送信セッション数",
      "description": "表示期間内に api_request を送ったセッション数。ログ送信開始前に起動していたセッションは集計に出ない (計測欠損)。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(count by (session_id) (count_over_time({event_name=\"api_request\", workspace=~\"$workspace\"} | session_id=~\"${session_id}\" [$__range])))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 1,
      "type": "stat",
      "title": "現在の最大context量",
      "description": "api_request 1回あたりの履歴トークン数 (context_tokens = cache_read + cache_creation) の期間内最大値。180,000 は Opus系 200,000 上限に対する危険水域。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100000
              },
              {
                "color": "orange",
                "value": 150000
              },
              {
                "color": "red",
                "value": 180000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(max_over_time({event_name=\"api_request\", workspace=~\"$workspace\"} | session_id=~\"${session_id}\" | unwrap context_tokens [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "table",
      "title": "セッション一覧（期間内）",
      "description": "workspace で絞り込んだセッションの一覧（コスト降順）。行の session_id クリックでこのセッションに絞り込む（セッション詳細ビュー）。どのセッションが問題かの一次切り分け。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (session_id) (sum_over_time({event_name=\"api_request\", workspace=~\"$workspace\"} | session_id=~\"${session_id}\" | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [$__range]))",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max by (session_id) (max_over_time({event_name=\"api_request\", workspace=~\"$workspace\"} | session_id=~\"${session_id}\" | unwrap context_tokens [$__range]))",
          "queryType": "instant"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (session_id) (count_over_time({event_name=\"api_request\", workspace=~\"$workspace\"} | session_id=~\"${session_id}\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "session_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time": true
            },
            "renameByName": {
              "Value #A": "コスト",
              "Value #B": "最大context",
              "Value #C": "リクエスト数"
            },
            "indexByName": {
              "session_id": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "コスト",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "session_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "このセッションに絞り込む",
                    "url": "/d/claude-code-context/claude-code-context?var-session_id=${__data.fields.session_id}&var-workspace=$workspace&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "コスト"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "最大context"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "リクエスト数"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "モデル×経路コスト（期間内）",
      "description": "絞り込み範囲（workspace × session_id）のコストを モデル × 経路（本体 / 委任 / 背景）で分解。O7: 本体列に意図しない高額モデル → /model 切替。O6: 委任列が高額モデルに寄る → agent への model 指定を施策候補へ。Today の workspace別サマリ（$/1M実効の違和感）から降りて帰属を確定する場所。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (model) (sum_over_time({event_name=\"api_request\", query_source=\"repl_main_thread\", workspace=~\"$workspace\"} | session_id=~\"${session_id}\" | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [$__range]))",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (model) (sum_over_time({event_name=\"api_request\", query_source=~\"agent:.*\", workspace=~\"$workspace\"} | session_id=~\"${session_id}\" | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [$__range]))",
          "queryType": "instant"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (model) (sum_over_time({event_name=\"api_request\", query_source!~\"repl_main_thread|agent:.*\", workspace=~\"$workspace\"} | session_id=~\"${session_id}\" | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [$__range]))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "model",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time": true
            },
            "renameByName": {
              "Value #A": "本体",
              "Value #B": "委任",
              "Value #C": "背景"
            },
            "indexByName": {
              "model": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "reducer": "sum",
              "include": [
                "本体",
                "委任",
                "背景"
              ]
            },
            "alias": "計",
            "replaceFields": false
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "計",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "noValue": "-",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "model"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          }
        ]
      }
    },
