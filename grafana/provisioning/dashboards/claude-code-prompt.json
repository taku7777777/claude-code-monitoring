        "name": "セッション内プロンプト",
        "expr": "{event_name=\"user_prompt\"} | session_id=~\"$session_id\" | label_format p=`{{ regexReplaceAll \"\\n\" (regexReplaceAll \"(?s)^(.{200}).*\" .prompt \"${1} …\") \"<br>\" }}`",
        "textFormat": "{{p}}",
        "titleFormat": "",
        "tagKeys": "__none__"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "prompt_id",
        "label": "prompt_id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "description": "プロンプト一覧の行リンク、または prompt_id を貼り付け"
      },
      {
        "name": "session_id",
        "label": "session_id",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
