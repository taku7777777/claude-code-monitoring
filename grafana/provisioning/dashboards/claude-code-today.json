        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "values": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 28,
      "type": "piechart",
      "title": "",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 5,
        "y": 3,
        "w": 5,
        "h": 3
      },
      "timeFrom": "now/d",
      "hideTimeOverride": true,
      "options": {
        "reduceOptions": {
          "calcs": [
