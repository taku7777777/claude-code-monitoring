        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({event_name=\"api_request\", workspace=~\"$workspace\"} | session_id=~\"$session_id\" | unwrap input_tokens [$__range])) + sum(sum_over_time({event_name=\"api_request\", workspace=~\"$workspace\"} | session_id=~\"$session_id\" | unwrap output_tokens [$__range])) + sum(sum_over_time({event_name=\"api_request\", workspace=~\"$workspace\"} | session_id=~\"$session_id\" | unwrap cache_read_tokens [$__range])) + sum(sum_over_time({event_name=\"api_request\", workspace=~\"$workspace\"} | session_id=~\"$session_id\" | unwrap cache_creation_tokens [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
