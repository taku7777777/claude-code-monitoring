      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time({event_name=\"api_request\"} | prompt_id=\"$prompt_id\" | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [$__range]))",
          "datasource": {
            "type": "loki",
