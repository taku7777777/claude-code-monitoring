  "templating": {
    "list": [
      {
        "name": "workspace",
        "type": "query",
        "label": "workspace",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values(workspace)",
        "query": {
          "label": "workspace",
          "stream": "",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "session_id",
        "type": "textbox",
        "label": "session_id",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "wfrom",
        "label": "窓開始(ms)",
        "hide": 2,
        "query": "0",
        "current": {
          "text": "0",
          "value": "0"
        }
      },
      {
        "type": "textbox",
        "name": "wto",
        "label": "窓終了(ms)",
        "hide": 2,
        "query": "99999999999999",
        "current": {
          "text": "99999999999999",
          "value": "99999999999999"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "stat",
      "title": "窓開始",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "vector(${wfrom})"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "(未指定)",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "99999999999999": {
                  "text": "(未指定)",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "窓終了",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "vector(${wto})"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "(未指定)",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "99999999999999": {
                  "text": "(未指定)",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 1,
      "type": "table",
      "title": "プロンプト一覧（session/workspace のプロンプト・実コスト）",
      "description": "一次イベント api_request を prompt_id で集計した実コスト・実効トークンの一覧（コスト = cost_recalc 優先の合計＝セッション/ワークスペースの総コストと一致）。プロンプト文は一次イベント user_prompt から結合。開始 = 最初の API 呼び出し、終了 = 最後の API 呼び出し。取り込み比 = cache_creation / output。再作成率 = cache_creation / (cache_creation + cache_read)＝プロンプト側トークンのうちキャッシュから読めず作り直した割合（高い＝キャッシュ失効の再構築 or 取り込み過多。橙≥40% / 赤≥70%）。長い放置後の直後プロンプトはここが跳ねる（TTL≈1h失効の再構築費）。フッタ合計 = 表示中プロンプトの総コスト・総実効トークン。窓（wfrom/wto — Today のバークリックで渡る）指定時はその時間窓内の API 呼び出しのみを集計（未指定＝全量）。ページの時間レンジが検索対象範囲。旧 prompt_summary（テイラー）はコストを過小計上するため使用しない。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "maxLines": 5000,
          "expr": "{event_name=\"api_request\", workspace=~\"$workspace\"} | session_id=~\"$session_id\" | label_format cv=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | label_format ts_ms=\"{{ divf .observed_timestamp 1000000 }}\" | ts_ms >= ${wfrom} | ts_ms <= ${wto}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "maxLines": 5000,
          "expr": "{event_name=\"user_prompt\", workspace=~\"$workspace\"} | session_id=~\"$session_id\""
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "cv",
                "destinationType": "number"
              },
              {
                "targetField": "ts_ms",
                "destinationType": "number"
              },
              {
                "targetField": "effective_tokens",
                "destinationType": "number"
              },
              {
                "targetField": "cache_creation_tokens",
                "destinationType": "number"
              },
              {
                "targetField": "cache_read_tokens",
                "destinationType": "number"
              },
              {
                "targetField": "output_tokens",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "prompt_id": {
                "operation": "groupby",
                "aggregations": []
              },
              "ts_ms": {
                "operation": "aggregate",
                "aggregations": [
                  "min",
                  "max"
                ]
              },
              "cv": {
                "operation": "aggregate",
                "aggregations": [
                  "sum"
                ]
              },
              "effective_tokens": {
                "operation": "aggregate",
                "aggregations": [
                  "sum"
                ]
              },
              "cache_creation_tokens": {
                "operation": "aggregate",
                "aggregations": [
                  "sum"
                ]
              },
              "cache_read_tokens": {
                "operation": "aggregate",
                "aggregations": [
                  "sum"
                ]
              },
              "output_tokens": {
                "operation": "aggregate",
                "aggregations": [
                  "sum"
                ]
              },
              "prompt": {
                "operation": "aggregate",
                "aggregations": [
                  "lastNotNull"
                ]
              }
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "prompt_id",
            "mode": "outer"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "cache_creation_tokens (sum)",
              "operator": "/",
              "right": "output_tokens (sum)"
            },
            "alias": "取り込み比",
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "ts_ms (max)",
              "operator": "-",
              "right": "ts_ms (min)"
            },
            "alias": "実行時間",
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "cache_creation_tokens (sum)",
              "operator": "+",
              "right": "cache_read_tokens (sum)"
            },
            "alias": "_ccr",
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "cache_creation_tokens (sum)",
              "operator": "/",
              "right": "_ccr"
            },
            "alias": "再作成率",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "cache_creation_tokens (sum)": true,
              "cache_read_tokens (sum)": true,
              "output_tokens (sum)": true,
              "_ccr": true
            },
            "renameByName": {
              "ts_ms (min)": "開始",
              "ts_ms (max)": "終了",
              "cv (sum)": "コスト",
              "effective_tokens (sum)": "実効tok",
              "prompt (lastNotNull)": "prompt"
            },
            "indexByName": {
              "ts_ms (min)": 0,
              "ts_ms (max)": 1,
              "実行時間": 2,
              "cv (sum)": 3,
              "effective_tokens (sum)": 4,
              "取り込み比": 5,
              "再作成率": 6,
              "prompt": 7,
              "prompt_id": 8
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(開始|終了|実行時間|コスト|実効tok|取り込み比|再作成率|prompt|prompt_id)$"
            }
          }
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "コスト",
            "実効tok"
          ]
        },
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "コスト",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "開始"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:MM/DD HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "終了"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:MM/DD HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "実行時間"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "コスト"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "実効tok"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "取り込み比"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 95
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 15
                    },
                    {
                      "color": "red",
                      "value": 30
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "再作成率"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.4
                    },
                    {
                      "color": "red",
                      "value": 0.7
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "prompt_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "この prompt の明細を表示",
                    "url": "/d/claude-code-prompt/claude-code-prompt?var-prompt_id=${__data.fields.prompt_id}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
