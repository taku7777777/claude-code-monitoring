{
  "uid": "claude-code-today",
  "title": "Today",
  "tags": [
    "claude-code",
    "today"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now/d+7h",
    "to": "now"
  },
  "timepicker": {
    "hidden": true
  },
  "refresh": "30s",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": true,
        "iconColor": "purple",
        "name": "施策マーカー",
        "expr": "{event_name=\"intervention_marker\"}",
        "textFormat": "{{category}}: {{description}}",
        "titleFormat": "intervention"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 2,
      "type": "stat",
      "title": "本日コスト",
      "description": "本日 00:00 からの cost_recalc 合計（無色 — 判断は残り枠%で行う）。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 3
      },
      "timeFrom": "now/d",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({event_name=\"api_request\"} | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "hideTimeOverride": true
    },
    {
      "id": 7,
      "type": "stat",
      "title": "背景比率",
      "description": "repl_main_thread・agent:* 以外（prompt_suggestion / away_summary 等）÷ 全体。≥20% 黄 / ≥35% 赤（A2）。本日消費 $5 未満は分母不足（グレー・判定保留）。降り先: Cost Opt 診断の query_source別。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 3
      },
      "timeFrom": "now/d",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "((sum(sum_over_time({event_name=\"api_request\", query_source!~\"repl_main_thread|agent:.*\"} | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [$__range]))) or vector(0)) / (sum(sum_over_time({event_name=\"api_request\"} | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [$__range])) > 5)",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "分母不足",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.35
              }
            ]
          }
        },
        "overrides": []
      },
      "hideTimeOverride": true
    },
    {
      "id": 8,
      "type": "stat",
      "title": "キャッシュ有効率",
      "description": "cache_read ÷ (cache_read + cache_creation + input)。<85% 黄 / <70% 赤（A5）。プロンプト側トークン 100万未満は分母不足（グレー・判定保留 — 朝一は cache_creation 主体で必ず低く出るため）。降り先: セッション診断の cacheRead比率の谷。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 3
      },
      "timeFrom": "now/d",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "(sum(sum_over_time({event_name=\"api_request\"} | unwrap cache_read_tokens [$__range])) or vector(0)) / ((sum(sum_over_time({event_name=\"api_request\"} | unwrap cache_read_tokens [$__range])) + sum(sum_over_time({event_name=\"api_request\"} | unwrap cache_creation_tokens [$__range])) + sum(sum_over_time({event_name=\"api_request\"} | unwrap input_tokens [$__range]))) > 1000000)",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "分母不足",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      },
      "hideTimeOverride": true
    },
    {
      "id": 16,
      "type": "bargauge",
      "title": "コストの構成（query_source別 top6）",
      "description": "背景コスト比率が黄赤のときの一次切り分けを0クリック化する（提案B）。repl_main_thread=本作業 / agent:*=委任 / それ以外=背景（away_summary・prompt_suggestion・compact 等）。帰属の深掘りは Cost Opt 診断で行う。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 6
      },
      "timeFrom": "now/d",
      "hideTimeOverride": true,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sort_desc(topk(6, sum by (query_source) (sum_over_time({event_name=\"api_request\"} | label_format cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [$__range]))))",
          "legendFormat": "{{query_source}}",
          "queryType": "instant"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 27,
      "type": "piechart",
      "title": "",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 5,
        "h": 3
      },
      "timeFrom": "now/d",
      "hideTimeOverride": true,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum by (m) (sum_over_time({event_name=\"api_request\"} | label_format m=\"{{ .model | trimPrefix \\\"claude-\\\" }}\", cost_v=\"{{ if .cost_recalc }}{{ .cost_recalc }}{{ else }}{{ .cost_usd }}{{ end }}\" | unwrap cost_v [$__range]))",
          "legendFormat": "{{m}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
