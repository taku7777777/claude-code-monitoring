{
  "uid": "claude-code-prompt-list",
  "title": "プロンプト一覧",
  "tags": [
    "claude-code",
    "prompt-list"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "施策マーカー",
        "expr": "{event_name=\"intervention_marker\"}",
        "textFormat": "{{category}}: {{description}}",
        "titleFormat": "intervention"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "wfrom",
        "label": "窓開始(ms)",
        "hide": 2,
        "query": "0",
        "current": {
          "text": "0",
          "value": "0"
        }
      },
      {
        "type": "textbox",
        "name": "wto",
        "label": "窓終了(ms)",
        "hide": 2,
        "query": "99999999999999",
        "current": {
          "text": "99999999999999",
          "value": "99999999999999"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "stat",
      "title": "窓開始",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "vector(${wfrom})"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "(未指定)",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "99999999999999": {
                  "text": "(未指定)",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "窓終了",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "vector(${wto})"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "(未指定)",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "99999999999999": {
                  "text": "(未指定)",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 1,
      "type": "table",
      "title": "プロンプト一覧（窓に実行が重なるもの・全量）",
      "description": "窓（wfrom/wto — Today のバークリックで5分窓が渡り、上の『窓開始/窓終了』に表示される）に実行期間が重なるプロンプトを、**真の全体期間・総コスト**で一覧する（prompt_summary — CONTRACT §3.4。テイラーが30秒ごとに last-wins 追記、読みは max 集計で最新版を採用）。開始 = 入力時刻、終了 = 最後の API 呼び出し。中断・放置された依頼も漏れない。直近30秒はサマリ未生成のことがある（テイラーのラグ）。フッタの合計は『窓に重なった依頼の全量合計』（窓内の寄与額ではない）。ページの時間レンジは検索対象範囲（リンク経由では窓終端の48h前〜窓終端）で、窓そのものではない点に注意。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "maxLines": 2000,
          "expr": "{event_name=\"prompt_summary\"} | end_ms >= ${wfrom} | start_ms <= ${wto}"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "start_ms",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "end_ms",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "cost_total",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "eff_total",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "creation_main",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "output_main",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "prompt_id": {
                "operation": "groupby",
                "aggregations": []
              },
              "start_ms": {
                "operation": "aggregate",
                "aggregations": [
                  "max"
                ]
              },
              "end_ms": {
                "operation": "aggregate",
                "aggregations": [
                  "max"
                ]
              },
              "cost_total": {
                "operation": "aggregate",
                "aggregations": [
                  "max"
                ]
              },
              "eff_total": {
                "operation": "aggregate",
                "aggregations": [
                  "max"
                ]
              },
              "creation_main": {
                "operation": "aggregate",
                "aggregations": [
                  "max"
                ]
              },
              "output_main": {
                "operation": "aggregate",
                "aggregations": [
                  "max"
                ]
              },
              "prompt": {
                "operation": "aggregate",
                "aggregations": [
                  "lastNotNull"
                ]
              }
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "creation_main (max)",
              "operator": "/",
              "right": "output_main (max)"
            },
            "alias": "取り込み比",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "start_ms (max)": "開始",
              "end_ms (max)": "終了",
              "cost_total (max)": "コスト",
              "eff_total (max)": "実効tok",
              "prompt (lastNotNull)": "prompt"
            },
            "indexByName": {
              "start_ms (max)": 0,
              "end_ms (max)": 1,
              "cost_total (max)": 2,
              "eff_total (max)": 3,
              "取り込み比": 4,
              "prompt": 5,
              "prompt_id": 6
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(開始|終了|コスト|実効tok|取り込み比|prompt|prompt_id)$"
            }
          }
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "コスト",
            "実効tok"
          ]
        },
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "コスト",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "開始"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:MM/DD HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "終了"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:MM/DD HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "コスト"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "実効tok"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "取り込み比"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 95
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 15
                    },
                    {
                      "color": "red",
                      "value": 30
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "prompt_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "この prompt の明細を表示",
                    "url": "/d/claude-code-prompt/claude-code-prompt?var-prompt_id=${__data.fields.prompt_id}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "links": []
}
